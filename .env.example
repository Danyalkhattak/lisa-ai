# ============================================
# Lisa AI - Environment Variables
# ============================================

# Convex (required - auto-configured by npx convex dev)
# NEXT_PUBLIC_CONVEX_URL=https://your-convex-site.convex.cloud

# Clerk Authentication (required)
# Get keys at https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISH_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here

# Google Gemini AI (required)
# Get key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# EMAIL SENDING - REQUIRED FOR REAL EMAILS
# ============================================

# Resend API Key (FREE tier: 3000 emails/month)
# 1. Go to https://resend.com/signup
# 2. Create account & verify email
# 3. Copy API key from Dashboard > API Keys
RESEND_API_KEY=re_your_resend_api_key_here

# Optional: Custom sender email
# For free tier, use: onboarding@resend.dev
# For custom domain, verify domain in Resend first
EMAIL_FROM=Lisa AI <onboarding@resend.dev>
