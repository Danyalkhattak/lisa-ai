# ============================================
# Lisa AI - Environment Variables
# ============================================

# Convex (required - auto-configured by npx convex dev)
# NEXT_PUBLIC_CONVEX_URL=https://your-convex-site.convex.cloud

# Clerk Authentication (required)
# Get keys at https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISH_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here

# Google Gemini AI (required)
# Get key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
